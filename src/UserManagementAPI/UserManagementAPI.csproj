<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.5" />
    <!--
      Microsoft.AspNetCore.OpenApi 10.0.5 resolves Microsoft.OpenApi 2.0.0 transitively, and that
      version carries advisory GHSA-v5pm-xwqc-g5wc (first patched in 2.7.5). Pinning the patched
      version directly keeps the build free of security warnings.
    -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <!-- Serves the interactive Swagger UI over the OpenAPI document produced above. -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

</Project>
